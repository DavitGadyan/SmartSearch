# Copy to .env (repo root) — read by docker compose and by backend/app/core/config.py

# --- Postgres (pgvector) ---
POSTGRES_USER=smartsearch
POSTGRES_PASSWORD=smartsearch
POSTGRES_DB=smartsearch
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://smartsearch:smartsearch@localhost:5435/smartsearch

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MLflow ---
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# --- Admin console / analytics API auth ---
ADMIN_API_KEY=dev-admin-key

# --- LLM (optional; agent falls back to rule-based search without it) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
BULK_MODEL=claude-haiku-5-5

# --- Microsoft-Decision-1 (typed decision scoring; optional, falls back to local heuristics) ---
# backend: auto | openrouter | foundry | local. OpenRouter: POST https://openrouter.ai/api/alpha/decisions
DECISION_BACKEND=auto
OPENROUTER_API_KEY=
DECISION1_ENDPOINT=
DECISION1_DEPLOYMENT=Microsoft-Decision-1
DECISION1_API_KEY=

# --- Product imagery (optional; https://cloud.higgsfield.ai -> API keys). `make images` generates photos for the
# most-shown products; without keys it prints the prompts and the storefront shows category tiles. ~0.25-1.5 credits/image.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
IMAGE_MODEL=qwen

# --- Frontend ---
# Next.js reads frontend/.env.local (gitignored), not this file: copy these three lines there.
NEXT_PUBLIC_API_URL=http://localhost:8000
# console access keyword (server-side only; never NEXT_PUBLIC_). The web server also needs ADMIN_API_KEY from above.
ADMIN_PASSWORD=change-me

# Agentic Commerce Protocol (merchant endpoints under /acp). The payment side is a labelled mock.
ACP_API_KEY=dev-acp-key
ACP_MERCHANT_ID=smartsearch-demo
# ACP_WEBHOOK_URL=https://example.com/acp/webhooks   # order_create / order_update, signed with Merchant-Signature
ACP_WEBHOOK_SECRET=dev-acp-webhook-secret
PUBLIC_WEB_URL=http://localhost:3000
